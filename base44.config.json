{
  "name": "harold-hub",
  "version": "1.0.0",
  "backend": {
    "functions": [
      {
        "name": "chat",
        "path": "functions/chat.js",
        "methods": ["POST"]
      }
    ],
    "entities": [
      {
        "name": "Conversation",
        "fields": [
          { "name": "sessionId", "type": "string", "required": true },
          { "name": "messages", "type": "json", "required": true },
          { "name": "createdAt", "type": "date", "required": true },
          { "name": "updatedAt", "type": "date", "required": true }
        ]
      }
    ]
  }
}